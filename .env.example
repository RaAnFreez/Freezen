# Local development only. Never commit real secrets.
FREZEN_ENV=development
FREZEN_API_TOKEN=
FREZEN_MASTER_SECRET=
SAFELINKU_API_KEY=
# Exact HTTPS API base URL supplied by SafeLinkU documentation/account.
# Leave blank until the official API contract is available.
SAFELINKU_API_BASE_URL=
DISCORD_BOT_TOKEN=
DISCORD_BOT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_BUYER_ROLE_ID=
OWNER_EMAIL=
OWNER_USER_ID=

# Cloudflare deployment uses Wrangler secrets instead of this file.
# Configure FREZEN_API_TOKEN and SAFELINKU_API_KEY as Worker Secrets in the appropriate environment.
CLOUDFLARE_ACCOUNT_ID=